[Unit]
Description=aws-ha-three-tier demo application
Wants=network-online.target
After=network-online.target

[Service]
User=app
WorkingDirectory=/opt/app
EnvironmentFile=/etc/app.env
ExecStart=/opt/app/venv/bin/gunicorn --workers 2 --threads 4 --keep-alive 75 --no-control-socket --bind 0.0.0.0:8080 app:app
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
